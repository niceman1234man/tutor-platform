# SMTP account provided by your email host
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=Skill Nest <no-reply@example.com>

# Public frontend origin used to create password-reset links
FRONTEND_URL=https://your-frontend-domain.example